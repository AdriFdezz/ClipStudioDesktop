<Window x:Class="ClipStudioDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClipStudioDesktop.ViewModels"
        xmlns:local="clr-namespace:ClipStudioDesktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Clip Studio Desktop" Height="650" Width="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assets/Clip_Studio_Desktop_ico.ico"
        Background="{StaticResource BackgroundBrush}"
        Deactivated="Window_Deactivated">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource SurfaceBrush}" Padding="20" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <!-- Placeholder for Logo if needed -->
                    <TextBlock Text="Clip Studio Desktop" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Configuración" FontSize="24" FontWeight="Light" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v1.0.0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
            <!-- General Tab -->
            <TabItem Header="GENERAL">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <GroupBox Header="Opciones de Inicio">
                            <StackPanel Margin="5">
                                <CheckBox Content="Iniciar con Windows" IsChecked="{Binding Settings.General.StartWithWindows}" Margin="0,8"/>
                                <CheckBox Content="Mostrar notificaciones" IsChecked="{Binding Settings.General.ShowNotifications}" Margin="0,8"/>
                                <CheckBox Content="Reproducir sonido al guardar" IsChecked="{Binding Settings.General.PlaySoundOnClip}" Margin="0,8"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Carpetas de Almacenamiento">
                            <StackPanel Margin="5">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Carpeta de Audio" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button Grid.Column="1" Content="Abrir Carpeta" Command="{Binding OpenAudioFolderCommand}" Width="120" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Carpeta de Video" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button Grid.Column="1" Content="Abrir Carpeta" Command="{Binding OpenVideoFolderCommand}" Width="120" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Carpeta de Imágenes" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button Grid.Column="1" Content="Abrir Carpeta" Command="{Binding OpenImagesFolderCommand}" Width="120" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio/Video Tab -->
            <TabItem Header="AUDIO Y VIDEO">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <GroupBox Header="Configuración de Audio">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.Audio.Format}" SelectedValuePath="Content" Margin="0,5"
                                          ToolTip="Formato de archivo de audio (mp3, wav).">
                                    <ComboBoxItem Content="mp3"/>
                                    <ComboBoxItem Content="wav"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="Bitrate (kbps)" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Settings.Audio.Bitrate}" SelectedValuePath="Tag" Margin="0,5"
                                          ToolTip="Calidad de audio en kbps. 192 es calidad estándar alta.">
                                    <ComboBoxItem Content="128 kbps (Estándar)" Tag="128"/>
                                    <ComboBoxItem Content="192 kbps (Alta)" Tag="192"/>
                                    <ComboBoxItem Content="320 kbps (Máxima)" Tag="320"/>
                                </ComboBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Configuración de Video">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.Video.Format}" SelectedValuePath="Content" Margin="0,5"
                                          ToolTip="Formato de archivo de video (mp4, mkv).">
                                    <ComboBoxItem Content="mp4"/>
                                    <ComboBoxItem Content="mkv"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="FPS" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Settings.Video.Framerate}" SelectedValuePath="Tag" Margin="0,5"
                                          ToolTip="Cuadros por segundo. 60 para fluidez, 30 para menor tamaño.">
                                    <ComboBoxItem Content="30" Tag="30"/>
                                    <ComboBoxItem Content="60" Tag="60"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="Bitrate (kbps)" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding Settings.Video.Bitrate}" SelectedValuePath="Tag" Margin="0,5"
                                          ToolTip="Calidad de video en kbps. 8000 es buena calidad para 1080p.">
                                    <ComboBoxItem Content="4000 kbps (Baja - 720p)" Tag="4000"/>
                                    <ComboBoxItem Content="8000 kbps (Media - 1080p)" Tag="8000"/>
                                    <ComboBoxItem Content="15000 kbps (Alta - 1080p60)" Tag="15000"/>
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                        
                        <GroupBox Header="Buffer de Grabación">
                             <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Duración máxima (segundos)" VerticalAlignment="Center" Margin="0,10"/>
                                <TextBox Grid.Column="1" Text="{Binding Settings.Buffer.MaxDurationSeconds}" Margin="0,5"
                                         ToolTip="Tiempo máximo de grabación que se mantiene en el buffer de disco (Audio y Video)."/>
                             </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="ATAJOS">
                <Grid Margin="0,20,0,0">
                    <DataGrid x:Name="HotkeysGrid" ItemsSource="{Binding Settings.Hotkeys}" AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tecla" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center" Padding="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Key}" 
                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                 GotFocus="HotkeyTextBox_GotFocus"
                                                 LostFocus="HotkeyTextBox_LostFocus"
                                                 IsReadOnly="True" 
                                                 Cursor="Hand"
                                                 ToolTip="Presiona la combinación de teclas deseada"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Duración (s)" Binding="{Binding Duration}" Width="100"/>
                            <DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Status Tab -->
            <TabItem Header="ESTADO">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <GroupBox Header="Estado del Sistema">
                            <StackPanel Margin="5">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Estado de Grabación" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Background="#102E10" CornerRadius="4" HorizontalAlignment="Left" Padding="10,2" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding StatusText}" Foreground="#4CAF50" FontWeight="Bold"/>
                                        </Border>
                                        <Button Content="{Binding RecordingButtonText}" Command="{Binding ToggleRecordingCommand}" Padding="10,2"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tamaño Buffer (Disco)" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BufferSizeText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Estadísticas de Hoy">
                            <StackPanel Margin="5">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Clips Guardados" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ClipsTodayText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Espacio Usado" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SpaceUsedText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Restaurar Valores" Command="{Binding ResetCommand}" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                <Button Content="Guardar Configuración" Command="{Binding SaveCommand}" Width="180"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>