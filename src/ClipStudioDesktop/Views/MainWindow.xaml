<Window x:Class="ClipStudioDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClipStudioDesktop.ViewModels"
        xmlns:local="clr-namespace:ClipStudioDesktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Clip Studio Desktop" Height="650" Width="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Icon="pack://application:,,,/assets/Clip_Studio_Desktop_ico.ico"
        Background="{StaticResource BackgroundBrush}"
        Deactivated="Window_Deactivated">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource SurfaceBrush}" Padding="20" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <!-- Placeholder for Logo if needed -->
                    <TextBlock Text="Clip Studio Desktop" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Configuración" FontSize="24" FontWeight="Light" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v1.0.0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="15,10,15,15" Background="Transparent" BorderThickness="0">
            <!-- General Tab -->
            <TabItem Header="GENERAL">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,15,0">
                        <GroupBox Header="Opciones de Inicio">
                            <StackPanel>
                                <CheckBox Content="Iniciar con Windows" IsChecked="{Binding Settings.General.StartWithWindows}" Margin="0,8"/>
                                <CheckBox Content="Mostrar notificaciones" IsChecked="{Binding Settings.General.ShowNotifications}" Margin="0,8"/>
                                <CheckBox Content="Reproducir sonido al guardar" IsChecked="{Binding Settings.General.PlaySoundOnClip}" Margin="0,8"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Carpetas de Almacenamiento">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Carpeta de Audio" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Abrir Carpeta" Command="{Binding OpenAudioFolderCommand}" Width="140" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Carpeta de Video" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Abrir Carpeta" Command="{Binding OpenVideoFolderCommand}" Width="140" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Carpeta de Imágenes" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Abrir Carpeta" Command="{Binding OpenImagesFolderCommand}" Width="140" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio/Video Tab -->
            <TabItem Header="AUDIO Y VIDEO">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,15,0">
                        <GroupBox Header="Configuración de Audio">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Formato" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding Settings.Audio.Format}" SelectedValuePath="Content" Margin="0,5"
                                          ToolTip="Formato de archivo de audio (mp3, flac).">
                                    <ComboBoxItem Content="mp3"/>
                                    <ComboBoxItem Content="flac"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="Bitrate (kbps)" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Settings.Audio.Bitrate}" SelectedValuePath="Tag" Margin="0,5"
                                          ToolTip="Calidad de audio en kbps. 192 es calidad estándar alta.">
                                    <ComboBoxItem Content="128 kbps (Estándar)" Tag="128"/>
                                    <ComboBoxItem Content="192 kbps (Alta)" Tag="192"/>
                                    <ComboBoxItem Content="320 kbps (Máxima)" Tag="320"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="Micrófono" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" 
                                          ItemsSource="{Binding AvailableMicrophones}" 
                                          SelectedValue="{Binding Settings.Audio.SelectedMicrophone}" 
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="DeviceName"
                                          Margin="0,5"
                                          ToolTip="Selecciona el micrófono a usar para las grabaciones"/>

                                <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Incluir micrófono en grabaciones" 
                                          IsChecked="{Binding Settings.Audio.EnableMicrophone}" 
                                          Margin="0,10"
                                          ToolTip="Mezcla el audio de tu micrófono con el audio del sistema en las grabaciones"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Configuración de Video">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Formato de Video" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.Video.Format}" SelectedValuePath="Content" Margin="0,5"
                                          ToolTip="Formato de archivo de video (mp4, mkv).">
                                    <ComboBoxItem Content="mp4"/>
                                    <ComboBoxItem Content="mkv"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="FPS" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Settings.Video.Framerate}" SelectedValuePath="Tag" Margin="0,5"
                                          ToolTip="Cuadros por segundo. 60 para fluidez, 30 para menor tamaño.">
                                    <ComboBoxItem Content="30" Tag="30"/>
                                    <ComboBoxItem Content="60" Tag="60"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="Bitrate (kbps)" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding Settings.Video.Bitrate}" SelectedValuePath="Tag" Margin="0,5"
                                          ToolTip="Calidad de video en kbps. 8000 es buena calidad para 1080p.">
                                    <ComboBoxItem Content="4000 kbps (Baja - 720p)" Tag="4000"/>
                                    <ComboBoxItem Content="8000 kbps (Media - 1080p)" Tag="8000"/>
                                    <ComboBoxItem Content="15000 kbps (Alta - 1080p60)" Tag="15000"/>
                                </ComboBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Configuración de Imagen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Formato de Imagen" VerticalAlignment="Center" Margin="0,10"/>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding Settings.Screenshot.Format}" SelectedValuePath="Content" Margin="0,5"
                                          ToolTip="Formato de archivo para las capturas de pantalla (png, jpg).">
                                    <ComboBoxItem Content="png"/>
                                    <ComboBoxItem Content="jpg"/>
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                        
                        <GroupBox Header="Límite de Grabación (Seguridad)">
                             <StackPanel>
                                <TextBlock Text="Límite de tamaño (GB)" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Text="Si la grabación alcanza este tamaño, se detendrá automáticamente para evitar llenar el disco. (0 = Sin límite)" 
                                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" FontSize="11"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Límite Máximo" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Text="{Binding Settings.Buffer.MaxBufferSizeGB}" Width="80"
                                                 ToolTip="Tamaño máximo en GB antes de detener (ej. 10)"/>
                                        <TextBlock Text="GB" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                             </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="ATAJOS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,15,0">

                    <!-- Info Box -->
                    <Border Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Cómo cambiar los atajos" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,5"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="1.0" Margin="0,2,0,10"/>
                            <TextBlock Text="Haz doble clic en la columna 'Atajo de Teclado' y presiona la nueva combinación de teclas." 
                                       Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Aviso: Dependiendo del atajo que elijas, puede crear conflictos con otros de otras aplicaciones ya existentes." 
                                           Foreground="#FFA500" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Content="Deshacer Cambios" 
                                    Command="{Binding ReloadSettingsCommand}"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    ToolTip="Restaura los atajos a su última configuración guardada">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            Padding="{TemplateBinding Padding}" 
                                                            CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0097FB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="HotkeysGrid" ItemsSource="{Binding Settings.Hotkeys}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="Cell" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                              VerticalAlignment="Top">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Acción" Binding="{Binding Description}" Width="250" IsReadOnly="True" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Atajo de Teclado" Width="*" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center" Padding="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Key}" 
                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                 GotFocus="HotkeyTextBox_GotFocus"
                                                 LostFocus="HotkeyTextBox_LostFocus"
                                                 Loaded="HotkeyTextBox_Loaded"
                                                 IsReadOnly="True" 
                                                 Cursor="Hand"
                                                 ToolTip="Presiona la combinación de teclas deseada"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

            <!-- Status Tab -->
            <TabItem Header="ESTADO">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,15,0">
                    <GroupBox Header="Estado del Sistema">
                        <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Estado de Grabación" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Background="#102E10" CornerRadius="4" HorizontalAlignment="Left" Height="28" Padding="6,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Content="{Binding VideoButtonText}" Command="{Binding ToggleVideoCommand}" IsEnabled="{Binding IsVideoCaptureEnabled}" Width="110" Height="28" Margin="0,0,8,0"/>
                                        <Button Content="{Binding AudioButtonText}" Command="{Binding ToggleAudioCommand}" IsEnabled="{Binding IsAudioCaptureEnabled}" Width="110" Height="28" Margin="0,0,8,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tamaño Actual RAW" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BufferSizeText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Estadísticas Totales">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Primera columna -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Clips Audio" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AudioClipsText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Clips Video" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VideoClipsText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Segunda columna -->
                                <StackPanel Grid.Column="1">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Imágenes" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ImagesText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Espacio Usado" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SpaceUsedText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Restaurar Valores" Command="{Binding ResetCommand}" Width="180" Height="40" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2D2D32"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3E3E42"/>
                                    <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Guardar Configuración" Command="{Binding SaveCommand}" Width="180" Height="40"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>