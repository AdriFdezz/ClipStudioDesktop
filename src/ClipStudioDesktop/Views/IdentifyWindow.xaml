<Window x:Class="ClipStudioDesktop.Views.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IdentifyWindow"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    
    <!-- Recursos de la ventana: Definición de animaciones -->
    <Window.Resources>
        <!-- Animación de identificación: Fade In -> Espera -> Fade Out -->
        <Storyboard x:Key="IdentifyAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>       <!-- Inicio invisible -->
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>     <!-- Fade In (0.5s) -->
                <EasingDoubleKeyFrame KeyTime="0:0:4.5" Value="1"/>     <!-- Mantener visible (4s) -->
                <EasingDoubleKeyFrame KeyTime="0:0:5.0" Value="0"/>     <!-- Fade Out (0.5s) -->
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Panel principal visual -->
        <!-- Se ubica en la esquina inferior izquierda con margen 40,90 -->
        <Border x:Name="MainBorder" CornerRadius="20" Background="#2d2d30" BorderBrush="#007ACC" BorderThickness="2"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="40,0,0,90"
                Width="180" Height="180" Opacity="0">
            
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Etiqueta "PANTALLA" -->
                <TextBlock Text="PANTALLA" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,-5"/>
                
                <!-- Número del Monitor (con efecto de sombra) -->
                <TextBlock x:Name="NumberText" Text="1" 
                           FontSize="100" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#007ACC" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
