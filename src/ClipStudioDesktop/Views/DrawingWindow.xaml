<Window x:Class="ClipStudioDesktop.Views.DrawingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DrawingWindow" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False" 
        Topmost="True"
        WindowState="Normal"
        Background="Black">
    
    <Window.Resources>
        <!-- Estilo para botones de herramientas -->
        <Style x:Key="ToolButtonStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="BorderBrush" Value="#666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Estilo para botones +/- -->
        <Style x:Key="SizeButtonStyle" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                    <Setter Property="BorderBrush" Value="#777"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Gradiente de colores para el slider -->
        <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0000" Offset="0.0"/>
            <GradientStop Color="#FFFF00" Offset="0.17"/>
            <GradientStop Color="#00FF00" Offset="0.33"/>
            <GradientStop Color="#00FFFF" Offset="0.5"/>
            <GradientStop Color="#0000FF" Offset="0.67"/>
            <GradientStop Color="#FF00FF" Offset="0.83"/>
            <GradientStop Color="#FF0000" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Resources>
    
    <Grid>
        <!-- Imagen de Fondo (Captura de pantalla congelada) -->
        <Image x:Name="BackgroundImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <!-- Bordes con rayas discontinuas animadas -->
        <Canvas x:Name="BorderCanvas" IsHitTestVisible="False">
            <Line x:Name="TopBorder" Stroke="#00BFFF" StrokeThickness="3" StrokeDashArray="4 2" X1="0" Y1="2" X2="2000" Y2="2"/>
            <Line x:Name="BottomBorder" Stroke="#00BFFF" StrokeThickness="3" StrokeDashArray="4 2" X1="0" X2="2000"/>
            <Line x:Name="LeftBorder" Stroke="#00BFFF" StrokeThickness="3" StrokeDashArray="4 2" X1="2" Y1="0" X2="2" Y2="2000"/>
            <Line x:Name="RightBorder" Stroke="#00BFFF" StrokeThickness="3" StrokeDashArray="4 2" Y1="0" Y2="2000"/>
        </Canvas>
        
        <!-- Canvas para dibujar -->
        <Canvas x:Name="DrawingCanvas" Background="Transparent" 
                MouseDown="DrawingCanvas_MouseDown" 
                MouseMove="DrawingCanvas_MouseMove" 
                MouseUp="DrawingCanvas_MouseUp"/>
        
        <!-- Barra de herramientas arrastrable -->
        <Border x:Name="Toolbar" 
                Background="#1A1A1A" 
                BorderBrush="#00BFFF" 
                BorderThickness="1" 
                CornerRadius="6"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Margin="50,60,0,0"
                Opacity="0.95"
                MouseDown="Toolbar_MouseDown"
                MouseMove="Toolbar_MouseMove"
                MouseUp="Toolbar_MouseUp">
            <Grid>
                <StackPanel Orientation="Vertical" Margin="6,6,6,14">
                    
                    <!-- Fila de herramientas -->
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BtnCircle" Style="{StaticResource ToolButtonStyle}" 
                                MouseDown="Tool_Click" Tag="Circle">
                            <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="2" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <Border x:Name="BtnRectangle" Style="{StaticResource ToolButtonStyle}" 
                                MouseDown="Tool_Click" Tag="Rectangle">
                            <Rectangle Width="14" Height="10" Stroke="White" StrokeThickness="2" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <Border x:Name="BtnLine" Style="{StaticResource ToolButtonStyle}" 
                                MouseDown="Tool_Click" Tag="Line">
                            <Line X1="4" Y1="18" X2="18" Y2="4" Stroke="White" StrokeThickness="2" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <Border x:Name="BtnArrow" Style="{StaticResource ToolButtonStyle}" 
                                MouseDown="Tool_Click" Tag="Arrow">
                            <Path Data="M4,18 L18,4 M18,4 L12,4 M18,4 L18,10" 
                                  Stroke="White" StrokeThickness="2" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <Border x:Name="BtnPencil" Style="{StaticResource ToolButtonStyle}" 
                                MouseDown="Tool_Click" Tag="Pencil">
                            <Path Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25Z" 
                                  Fill="White" Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <Border x:Name="BtnEraser" Style="{StaticResource ToolButtonStyle}" 
                                MouseDown="Tool_Click" Tag="Eraser">
                            <Path Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z" 
                                  Fill="White" Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Separador vertical -->

                        
                        <!-- Botón de captura -->
                        <Border x:Name="BtnScreenshot" Style="{StaticResource ToolButtonStyle}" 
                                MouseDown="Screenshot_Click" ToolTip="Capturar pantalla con dibujos">
                            <Path Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" 
                                  Fill="White" Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Separador -->
                    <Rectangle Height="1" Fill="#444" Margin="0,4"/>
                    
                    <!-- Selector de tamaño - alineado a la izquierda -->
                    <StackPanel Orientation="Horizontal" Margin="2,2" HorizontalAlignment="Left">
                        <TextBlock Text="Tamaño:" Foreground="White" FontSize="9" VerticalAlignment="Center" Width="42"/>
                        <Border Style="{StaticResource SizeButtonStyle}" MouseDown="SizeDecrease_Click">
                            <TextBlock Text="-" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <Border Background="#222" CornerRadius="3" Padding="6,2" Margin="3,0">
                            <TextBlock x:Name="SizeLabel" Text="2 px" Foreground="White" FontSize="9" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource SizeButtonStyle}" MouseDown="SizeIncrease_Click">
                            <TextBlock Text="+" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Selector de color - alineado a la izquierda -->
                    <StackPanel Orientation="Horizontal" Margin="2,4,2,0" HorizontalAlignment="Left">
                        <TextBlock Text="Color:" Foreground="White" FontSize="9" VerticalAlignment="Center" Width="42"/>
                        <Border x:Name="ColorIndicator" Width="30" Height="16" Background="#FF4444" 
                                CornerRadius="3" BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                                MouseDown="ColorIndicator_Click"/>
                    </StackPanel>
                    
                    <!-- Slider de color (espectro) - oculto por defecto, con margen extra abajo -->
                    <Border x:Name="HueSliderContainer" Visibility="Collapsed" Margin="2,6,2,4"
                            Background="{StaticResource HueGradient}" CornerRadius="2" Height="10"
                            BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                            MouseDown="HueBar_MouseDown" MouseMove="HueBar_MouseMove" MouseUp="HueBar_MouseUp">
                        <!-- Indicador de posición - más visible -->
                        <Border x:Name="HueIndicator" Width="6" Height="14" Background="White" 
                                CornerRadius="2" HorizontalAlignment="Left" Margin="-1,-2,-1,-2"
                                BorderBrush="#333" BorderThickness="1" IsHitTestVisible="False"/>
                    </Border>
                </StackPanel>
                
                <!-- Icono de arrastre (esquina inferior derecha) -->
                <Path Data="M10,10 L14,14 M13,10 L14,10 L14,11 M10,13 L10,14 L11,14" 
                      Stroke="#666" StrokeThickness="1.5"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,4,2" Width="12" Height="12" Stretch="Uniform"/>
            </Grid>
        </Border>
        
        <!-- Indicador de modo activo -->
        <Border x:Name="ModeIndicator" 
                Background="#1A1A1A" 
                BorderBrush="#00BFFF" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="8,4" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Opacity="0.85">
            <StackPanel Orientation="Horizontal">
                <Path Data="M12,2A10,10 0 0,0 2,12C2,17.5 6.5,22 12,22C12.8,22 13.5,21.3 13.5,20.5C13.5,20.1 13.3,19.7 13.1,19.4L12.7,18.8C12.5,18.5 12.4,18.2 12.4,17.8C12.4,17 13,16.4 13.8,16.4H16C19.3,16.4 22,13.7 22,10.4C22,5.7 17.5,2 12,2M5.5,12C4.7,12 4,11.3 4,10.5C4,9.7 4.7,9 5.5,9C6.3,9 7,9.7 7,10.5C7,11.3 6.3,12 5.5,12M9.5,8C8.7,8 8,7.3 8,6.5C8,5.7 8.7,5 9.5,5C10.3,5 11,5.7 11,6.5C11,7.3 10.3,8 9.5,8M14.5,8C13.7,8 13,7.3 13,6.5C13,5.7 13.7,5 14.5,5C15.3,5 16,5.7 16,6.5C16,7.3 15.3,8 14.5,8M18.5,12C17.7,12 17,11.3 17,10.5C17,9.7 17.7,9 18.5,9C19.3,9 20,9.7 20,10.5C20,11.3 19.3,12 18.5,12Z" 
                      Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="MODO DIBUJO" Foreground="#00BFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text=" - " Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="ESC para salir" Foreground="White" FontSize="9" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Notificación de guardado (Clickable) -->
        <Border x:Name="NotificationBanner" 
                Visibility="Collapsed"
                CornerRadius="4" 
                Padding="16,10" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top"
                Margin="0,48,0,0"
                Opacity="0.95"
                Cursor="Hand"
                MouseDown="NotificationBanner_MouseDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="BorderBrush" Value="#00BFFF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <!-- Hover: Ligeramente más claro, mismos tonos -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="BorderBrush" Value="#66D9FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <StackPanel Orientation="Horizontal">
                <Path Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z" 
                      Fill="#00BFFF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Captura Guardada" Foreground="#00BFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="-" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Clic para abrir" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
    
    <!-- Animaciones -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="TopBorder" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-6" Duration="0:0:1.2"/>
                    <DoubleAnimation Storyboard.TargetName="BottomBorder" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="6" Duration="0:0:1.2"/>
                    <DoubleAnimation Storyboard.TargetName="LeftBorder" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-6" Duration="0:0:1.2"/>
                    <DoubleAnimation Storyboard.TargetName="RightBorder" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="6" Duration="0:0:1.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
