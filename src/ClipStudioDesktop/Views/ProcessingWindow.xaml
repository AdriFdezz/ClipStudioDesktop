<Window x:Class="ClipStudioDesktop.Views.ProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip Studio - Convirtiendo" Height="140" Width="350"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        Activated="Window_Activated"
        Closing="Window_Closing">
    <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <!-- Title with spinner animation -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Ellipse x:Name="Spinner" Width="16" Height="16" StrokeThickness="2" Margin="0,0,10,0">
                    <Ellipse.Stroke>
                        <LinearGradientBrush>
                            <GradientStop Color="#007ACC" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="8" CenterY="8"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock x:Name="TitleText" Text="Convirtiendo grabación..." Foreground="White" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
            
            <!-- Progress bar -->
            <ProgressBar x:Name="ProgressBar" Value="0" Minimum="0" Maximum="100" Height="6" 
                         Background="#3E3E42" Foreground="#007ACC" BorderThickness="0" Margin="0,0,0,8"/>
            
            <!-- Progress info -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PercentText" Text="0%" Foreground="#AAAAAA" FontSize="11"/>
                <TextBlock x:Name="TimeRemainingText" Grid.Column="1" Text="Calculando..." Foreground="#AAAAAA" FontSize="11"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>