<Window x:Class="ClipStudioDesktop.Views.ProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procesando" Height="100" Width="300"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="False"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded">
    <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="5" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Guardando clip..." Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="14"/>
            <ProgressBar IsIndeterminate="True" Height="4" Background="#3E3E42" Foreground="#007ACC" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>