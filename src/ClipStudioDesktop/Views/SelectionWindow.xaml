<Window x:Class="ClipStudioDesktop.Views.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SelectionWindow" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False" 
        Topmost="True"
        WindowState="Normal"
        Background="Black"
        Cursor="None">
    <Grid>
        <!-- Imagen de Fondo (Captura de pantalla congelada) -->
        <Image x:Name="BackgroundImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <!-- Capa Oscura (Overlay) con Agujero -->
        <Path Fill="Black" Opacity="0.6" IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <!-- Cubre toda la pantalla -->
                    <RectangleGeometry Rect="-10000,-10000,20000,20000" />
                    <!-- El agujero transparente para la selección -->
                    <RectangleGeometry x:Name="HoleGeometry" />
                </GeometryGroup>
            </Path.Data>
        </Path>
        
        <!-- Canvas de Selección -->
        <Canvas x:Name="SelectionCanvas" Background="Transparent" MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp">
            <Path x:Name="SelectionPath" Stroke="White" StrokeThickness="1" StrokeDashArray="4 2">
                <Path.Data>
                    <RectangleGeometry x:Name="SelectionGeometry" />
                </Path.Data>
            </Path>
            
            <!-- Texto con Dimensiones (Ancho x Alto) -->
            <Border x:Name="DimensionsBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Visibility="Collapsed">
                <TextBlock x:Name="DimensionsText" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Canvas>

        <!-- Capa para el Cursor Personalizado (Cruz) -->
        <Canvas IsHitTestVisible="False">
            <Canvas x:Name="CustomCursorCanvas">
                <!-- Borde Negro (Contorno) -->
                <Path Stroke="Black" StrokeThickness="3">
                    <Path.Data>
                        <GeometryGroup>
                            <LineGeometry StartPoint="-12,0" EndPoint="12,0"/>
                            <LineGeometry StartPoint="0,-12" EndPoint="0,12"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
                <!-- Núcleo Blanco -->
                <Path Stroke="White" StrokeThickness="2">
                    <Path.Data>
                        <GeometryGroup>
                            <LineGeometry StartPoint="-10,0" EndPoint="10,0"/>
                            <LineGeometry StartPoint="0,-10" EndPoint="0,10"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
                <!-- Punto Central -->
                <Ellipse Width="4" Height="4" Fill="Black" Canvas.Left="-2" Canvas.Top="-2" />
            </Canvas>
        </Canvas>
    </Grid>
</Window>
