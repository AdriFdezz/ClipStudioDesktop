<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <!-- Configuración del Producto -->
    <Product Id="*" Name="Clip Studio Desktop" Language="1033" Version="1.0.0.0" Manufacturer="AdriFdezz" UpgradeCode="38D12345-6789-ABCD-EF01-234567890ABC">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

        <!-- Permitir actualizaciones (desinstala la versión anterior primero) -->
        <MajorUpgrade DowngradeErrorMessage="Una versión más reciente de [ProductName] ya está instalada." />
        
        <!-- Empaquetar todo en un solo .msi -->
        <MediaTemplate EmbedCab="yes" />

        <!-- Icono para el Panel de Control (Agregar/Quitar programas) -->
        <Icon Id="icon.ico" SourceFile="$(var.PublishDir)\ClipStudioDesktop.exe"/>
        <Property Id="ARPPRODUCTICON" Value="icon.ico" />

        <!-- Interfaz Gráfica "Siguiente, Siguiente" -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
        <UIRef Id="WixUI_InstallDir" />
        <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

        <!-- Feature Principal -->
        <Feature Id="ProductFeature" Title="Clip Studio Desktop" Level="1">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="RegistryEntries" />
        </Feature>
    </Product>

    <Fragment>
        <!-- Estructura de Directorios -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="Clip Studio Desktop" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Clip Studio Desktop"/>
            </Directory>
        </Directory>
    </Fragment>

    <Fragment>
        <!-- Accesos Directos -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="49E56789-0123-4567-89AB-CDEF01234567">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="Clip Studio Desktop"
                          Description="Herramienta de grabación de escritorio"
                          Target="[INSTALLFOLDER]ClipStudioDesktop.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="icon.ico"/>
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\AdriFdezz\ClipStudioDesktop" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>
    </Fragment>

    <Fragment>
        <!-- Inicio Automático con Windows -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="RegistryEntries" Guid="5AF67890-1234-5678-9ABC-DEF012345678">
                <RegistryValue Root="HKCU"
                               Key="Software\Microsoft\Windows\CurrentVersion\Run"
                               Name="ClipStudioDesktop"
                               Type="string"
                               Value="[INSTALLFOLDER]ClipStudioDesktop.exe"
                               KeyPath="yes"/>
            </Component>
        </DirectoryRef>
    </Fragment>

    <Fragment>
        <!-- Archivos a Instalar -->
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <Component Id="ProductComponent" Guid="6B078901-2345-6789-ABCD-EF0123456789">
                <File Source="$(var.PublishDir)\ClipStudioDesktop.exe" KeyPath="yes" Checksum="yes"/>
            </Component>
            <Component Id="FFmpegComponent" Guid="7C189012-3456-7890-BCDE-F01234567890">
                <File Source="$(var.PublishDir)\ffmpeg.exe" KeyPath="yes" Checksum="yes"/>
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
